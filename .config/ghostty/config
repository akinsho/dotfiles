#----------------------------------
# DISPLAY
#----------------------------------
adjust-underline-position = 6
adjust-underline-thickness = 2
bold-is-bright = true
confirm-close-surface = false
config-file = "?local"
#----------------------------------
# Theme
#----------------------------------
theme = "github-dark-high-contrast"

#----------------------------------
# FONTS
#----------------------------------
font-family = "Cartograph CF"
font-size = 14
font-thicken = true

#----------------------------------
# MOUSE
#----------------------------------
mouse-hide-while-typing = true
#----------------------------------
# WINDOW
#----------------------------------
macos-titlebar-style = tabs
window-save-state = always
#----------------------------------
# KEYBINDINGS
#----------------------------------
macos-option-as-alt = left
# RESET ALL
# keybind = clear
#----------------------------------
# CORE
#----------------------------------
keybind = ctrl+shift+r=reload_config
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+plus=increase_font_size:1
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
# keybind = ctrl+shift+f=search
# keybind = cmd+shift+space=toggle_command_palette
#----------------------------------
# SPLITS
#----------------------------------
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:bottom
keybind = performable:ctrl+k=goto_split:top
keybind = performable:ctrl+l=goto_split:right
#----------------------------------
# New split
#----------------------------------
keybind = performable:ctrl+shift+/=new_split:auto
keybind = performable:ctrl+shift+l=new_split:right
keybind = performable:ctrl+shift+h=new_split:left
keybind = performable:ctrl+shift+j=new_split:down
keybind = performable:ctrl+shift+k=new_split:down
#----------------------------------
# TABS
#----------------------------------
keybind = super+shift+t=new_tab
keybind = super+shift+h=previous_tab
keybind = super+shift+l=next_tab
keybind = super+shift+comma=move_tab:-1
keybind = super+shift+period=move_tab:1
#----------------------------------
keybind = ctrl+shift+space=toggle_split_zoom
keybind = super+w=close_surface

keybind = global:super+shift+]=toggle_quick_terminal

shell-integration-features = ssh-env,ssh-terminfo
